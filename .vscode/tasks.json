{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build LeetCode (debug)",
            "type": "process",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/leetcode_main.cc",
                "-o",
                "${workspaceFolder}/leetcode_debug"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
