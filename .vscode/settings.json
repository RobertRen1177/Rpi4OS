{
    // Let clangd own IntelliSense; turn off the Microsoft C/C++ engine so the two don't report conflicting errors
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.errorSquiggles": "disabled",

    "clangd.arguments": [
        "--query-driver=/opt/homebrew/bin/aarch64-elf-*",
        "--header-insertion=never"
    ],

    "files.associations": {
        "*.h": "c"
    }
}
